{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JisN4DLWr14eMbun3gkrfs","type":"tool_result","content":"1\t// Streak logic for Habit Hatch. Dates are local-day keys: 'YYYY-MM-DD'.\n2\t// Works in Node and the browser (import '/src/streak.js').\n3\t\n4\tconst pad = (n) => String(n).padStart(2, '0');\n5\t\n6\t/**\n7\t * The local calendar date of `date` as 'YYYY-MM-DD'.\n8\t * @param {Date} [date=new Date()]\n9\t * @returns {string}\n10\t */\n11\texport function todayKey(date = new Date()) {\n12\t  return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;\n13\t}\n14\t\n15\t/** The day before a 'YYYY-MM-DD' key (UTC maths, so no DST surprises). */\n16\tfunction previousDay(key) {\n17\t  const [y, m, d] = key.split('-').map(Number);\n18\t  const t = new Date(Date.UTC(y, m - 1, d - 1));\n19\t  return `${t.getUTCFullYear()}-${pad(t.getUTCMonth() + 1)}-${pad(t.getUTCDate())}`;\n20\t}\n21\t\n22\t/**\n23\t * How many days in a row are done, counting back from `today`.\n24\t * If `today` itself is not done the streak is 0. Order, duplicates\n25\t * and future dates in `doneDates` do not matter.\n26\t * @param {string[]} doneDates 'YYYY-MM-DD' keys\n27\t * @param {string} today 'YYYY-MM-DD' key\n28\t * @returns {number}\n29\t */\n30\texport function currentStreak(doneDates, today) {\n31\t  const done = new Set(doneDates);\n32\t  let streak = 0;\n33\t  for (let day = today; done.has(day); day = previousDay(day)) streak++;\n34\t  return streak;\n35\t}\n36\t"}]},"parent_tool_use_id":null,"session_id":"6d665983-3070-4d1b-a3a3-eddb98928776","uuid":"b326f700-5b5a-435f-88b5-eda2e927ea3b","timestamp":"2026-11-14T00:38:09.544Z","tool_use_result":{"type":"text","file":{"filePath":"/private/tmp/claude-501/-Users-stage-dev-AI-Control-V2/2fd0ff91-5d61-498e-ab9e-e7196f1b394e/scratchpad/f3/home/worktrees/f3-habit-hatch/weekly-view-last-7-days-as-dots-plus-tic-0613112b/src/streak.js","content":"// Streak logic for Habit Hatch. Dates are local-day keys: 'YYYY-MM-DD'.\n// Works in Node and the browser (import '/src/streak.js').\n\nconst pad = (n) => String(n).padStart(2, '0');\n\n/**\n * The local calendar date of `date` as 'YYYY-MM-DD'.\n * @param {Date} [date=new Date()]\n * @returns {string}\n */\nexport function todayKey(date = new Date()) {\n  return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;\n}\n\n/** The day before a 'YYYY-MM-DD' key (UTC maths, so no DST surprises). */\nfunction previousDay(key) {\n  const [y, m, d] = key.split('-').map(Number);\n  const t = new Date(Date.UTC(y, m - 1, d - 1));\n  return `${t.getUTCFullYear()}-${pad(t.getUTCMonth() + 1)}-${pad(t.getUTCDate())}`;\n}\n\n/**\n * How many days in a row are done, counting back from `today`.\n * If `today` itself is not done the streak is 0. Order, duplicates\n * and future dates in `doneDates` do not matter.\n * @param {string[]} doneDates 'YYYY-MM-DD' keys\n * @param {string} today 'YYYY-MM-DD' key\n * @returns {number}\n */\nexport function currentStreak(doneDates, today) {\n  const done = new Set(doneDates);\n  let streak = 0;\n  for (let day = today; done.has(day); day = previousDay(day)) streak++;\n  return streak;\n}\n","numLines":36,"startLine":1,"totalLines":36}},"tool_result_meta":[{"id":"toolu_01JisN4DLWr14eMbun3gkrfs","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
