exports[`<Hero> / <Emblem> > emblem snapshot: pip 1`] = `"<span style="display: contents;"><span class="captain-pip" aria-hidden="true" style="--team: #2fd3c3;"><svg viewBox="-10 -10 20 20" focusable="false"><path d="M0 -7 L2.1 -2.3 L7 -2.2 L3.2 1.1 L4.4 6 L0 3.3 L-4.4 6 L-3.2 1.1 L-7 -2.2 L-2.1 -2.3Z"></path></svg></span></span>"`;

