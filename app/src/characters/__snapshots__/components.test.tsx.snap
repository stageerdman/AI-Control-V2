exports[`<Hero> / <Emblem> > emblem snapshot: decorative 1`] = `
"<span style="display: contents;"><span class="emblem" aria-hidden="true" style="--team:#8be88b;width:48px;height:48px"><svg viewBox="0 0 64 64" aria-hidden="true" focusable="false">
    <circle class="cloth" cx="32" cy="32" r="30"></circle>
    <circle class="line" cx="32" cy="32" r="27"></circle>
    <circle class="stitch" cx="32" cy="32" r="23.5"></circle>
    <path class="thread" d="M18 18 L32 28 L46 18 L36 32 L46 46 L32 36 L18 46 L28 32Z"></path>
    <path class="cloth halo" d="M32 10 L36 28 L54 32 L36 36 L32 54 L28 36 L10 32 L28 28Z"></path>
    <path class="thread" d="M32 10 L36 28 L54 32 L36 36 L32 54 L28 36 L10 32 L28 28Z"></path>
    <path class="cloth detail" d="M32 10 L32 32 L28 28Z M54 32 L32 32 L36 28Z M32 54 L32 32 L36 36Z M10 32 L32 32 L28 36Z"></path>
    <circle class="cloth" cx="32" cy="32" r="2.6"></circle></svg></span></span>"
`;

