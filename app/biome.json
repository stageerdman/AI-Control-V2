{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["src/**", "*.ts", "*.json", "src-tauri/*.json", "src-tauri/capabilities/**"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "css": { "parser": { "tailwindDirectives": true } },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    {
      "includes": [
        "src/characters/hero-svg.ts",
        "src/characters/emblem-svg.ts",
        "src/characters/*.css",
        "src/design/prototype.css",
        "src/gallery/gallery.css",
        "src/features/cast/cast.css"
      ],
      "formatter": { "enabled": false },
      "linter": {
        "rules": {
          "style": { "useTemplate": "off", "noDescendingSpecificity": "off" },
          "complexity": { "noImportantStyles": "off", "useOptionalChain": "off" },
          "correctness": { "noComponentHookFactories": "off" }
        }
      }
    },
    { "includes": ["src/characters/__fixtures__/**"], "formatter": { "enabled": false } }
  ]
}
