.DS_Store
.env
.env.*
!.env.example

# Dependencies
node_modules/
dist/
build/

# Rust/Tauri — build output goes to the shared Cargo target (~/.cargo-shared-target),
# never a per-project target/. A missing local target/ is expected.
target/

# Logs & local tooling
*.log
.vscode/
.idea/
# Agents' throwaway checks (screenshots, headless browsers, probe scripts) — never commit
.scratch/
updates/*/concepts/disney-v3/shots/
