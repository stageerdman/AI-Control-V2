# AI-Control-V2 — required environment keys (template; no secret values).
# Copy to .env and fill in, or let the AI sync from the global ~/.ai-control/.env.

# Core: the orchestrators and agents run on Claude.
ANTHROPIC_API_KEY=

# Optional: multi-provider support for agents.
OPENAI_API_KEY=

# Voice OUT — text-to-speech for agent/orchestrator replies.
ELEVENLABS_API_KEY=

# Voice IN — speech-to-text for voice control.
DEEPGRAM_API_KEY=

# Repo operations performed on behalf of projects.
GITHUB_TOKEN=
